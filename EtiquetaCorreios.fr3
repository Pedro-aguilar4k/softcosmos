<TfrxReport Tag="1" Version="5.6.18" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.AllowEdit="False" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="PDFCreator" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="43550,4130250579" ReportOptions.Description.Text="" ReportOptions.LastChange="44103,6835610301" ScriptLanguage="PascalScript" ScriptText.Text="procedure LogoLojaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  LogoLoja.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; = '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure LogoAmericanasOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  LogoAmericanas.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; = 'Lojas Americanas';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure LogoSubmarinoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  LogoSubmarino.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; = 'Submarino';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure LogoShoptimeOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  LogoShoptime.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; = 'Shoptime';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure LogoMercadoLivreOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  LogoMercadoLivre.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; = 'Mercado Livre';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure LogoCorreiosOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  LogoCorreios.Visible := (&#60;Orcamentos.&#34;LOJAMKP&#34;&#62; = '') or&#13;&#10;                          (&#60;Orcamentos.&#34;LOJAMKP&#34;&#62; = 'Mercado Livre');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure LogoPACOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  LogoPAC.Visible := Pos('PAC',Uppercase(&#60;EnderecoEntrega.&#34;TipoFreteEntrega&#34;&#62;)) &#62; 0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure LogoSEDEXOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  LogoSEDEX.Visible := (Pos('SEDEX',Uppercase(&#60;EnderecoEntrega.&#34;TipoFreteEntrega&#34;&#62;)) &#62; 0) or&#13;&#10;                       (Pos('BY_DIRECT',Uppercase(&#60;EnderecoEntrega.&#34;TipoFreteEntrega&#34;&#62;)) &#62; 0);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Barcode2D1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  CepDestino: String;&#13;&#10;  ValidadorCepDestino, I: Integer;&#13;&#10;  CodigoServico: String;&#13;&#10;&#13;&#10;  function PoeZero(AString: String; ATamanho: Integer): String;&#13;&#10;  var&#13;&#10;    I: Integer;&#13;&#10;  begin&#13;&#10;    Result := '';&#13;&#10;    for I := 1 to Length(AString) do&#13;&#10;      if AString[I] in ['0'..'9'] then&#13;&#10;        Result := Result + AString[I];&#13;&#10;&#13;&#10;    if Length(Result) &#62; ATamanho then&#13;&#10;      Result := Copy(Result,Length(Result)-ATamanho+1,ATamanho)&#13;&#10;    else&#13;&#10;      while Length(Result) &#60; ATamanho do&#13;&#10;        Result := '0' + Result;&#13;&#10;  end;&#13;&#10;&#13;&#10;  function PoeEspaco(AString: String; ATamanho: Integer): String;&#13;&#10;  begin&#13;&#10;    Result := AString;&#13;&#10;&#13;&#10;    if Length(Result) &#62; ATamanho then&#13;&#10;      Result := Copy(Result,1,ATamanho)&#13;&#10;    else&#13;&#10;      while Length(Result) &#60; ATamanho do&#13;&#10;        Result := Result + ' ';&#13;&#10;  end;&#13;&#10;&#13;&#10;begin&#13;&#10;  if &#60;EnderecoEntrega.&#34;Endereco&#34;&#62; &#60;&#62; '' then&#13;&#10;    CepDestino := PoeZero(&#60;EnderecoEntrega.&#34;CEP&#34;&#62;,8)&#13;&#10;  else&#13;&#10;    CepDestino := PoeZero(&#60;Orcamentos.&#34;CEP&#34;&#62;,8);&#13;&#10;&#13;&#10;  ValidadorCepDestino := 0;&#13;&#10;  for I := 1 to Length(CepDestino) do&#13;&#10;    ValidadorCepDestino := ValidadorCepDestino + StrToInt(CepDestino[I]);&#13;&#10;  if (ValidadorCepDestino mod 10) = 0 then&#13;&#10;    ValidadorCepDestino := 0&#13;&#10;  else&#13;&#10;    ValidadorCepDestino := 10 - (ValidadorCepDestino mod 10);&#13;&#10;&#13;&#10;  if Copy(&#60;EnderecoEntrega.&#34;TipoFreteEntrega&#34;&#62;,6,1) = '/' then&#13;&#10;    CodigoServico := Copy(&#60;EnderecoEntrega.&#34;TipoFreteEntrega&#34;&#62;,1,5)&#13;&#10;  else&#13;&#10;    CodigoServico := '';&#13;&#10;&#13;&#10;  qryEmpresa.Close;&#13;&#10;  qryEmpresa.Open;&#13;&#10;&#13;&#10;  Barcode2D1.Text :=&#13;&#10;      CepDestino + //CEP destino (8)&#13;&#10;      PoeZero('',5) + //Complemento do CEP (5)&#13;&#10;      PoeZero(&#60;Dados da Empresa.&#34;Cep&#34;&#62;,8) + //CEP origem (8)&#13;&#10;      PoeZero('',5) + //Complemento do CEP (5)&#13;&#10;      IntToStr(ValidadorCepDestino) + //Validador do CEP destino (1)&#13;&#10;      '51' + //IDV (2) - 51 Encomenda&#13;&#10;      PoeEspaco(&#60;Orcamentos.&#34;CodigoRastreamento&#34;&#62;,13) + //Código de Rastreamento (13)&#13;&#10;      PoeZero('',8) + //Serviços Adicionais (8) - AR, MP, DD, VD&#13;&#10;      PoeZero(&#60;qryEmpresa.&#34;CorreiosCartao&#34;&#62;,10) + //Cartão de Postagem (10)&#13;&#10;      PoeZero(CodigoServico,5) + //Código do Serviço (5)&#13;&#10;      PoeZero('',2) + //Informação de Agrupamento (2)&#13;&#10;      PoeZero('',5) + //Número do Logradouro (5)&#13;&#10;      PoeEspaco('',20) + //Complemento do Logradouro (20)&#13;&#10;      PoeZero('',5) + //Valor Declarado (5)&#13;&#10;      PoeZero(&#60;Orcamentos.&#34;DDD&#34;&#62;+&#60;Orcamentos.&#34;CELULAR&#34;&#62;,12) + //DDD + Telefone Destinatário (12)&#13;&#10;      '-00.000000' + //Latitude (10)&#13;&#10;      '-00.000000' + //Longitude (10)&#13;&#10;      '|' + //Pipe “|” (1)&#13;&#10;      PoeEspaco('',30); //Reserva para cliente (30)&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo3OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Memo18.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; = 'Mercado Livre';&#13;&#10;  Memo3.Visible := (&#60;Orcamentos.&#34;LOJAMKP&#34;&#62; &#60;&#62; 'Mercado Livre') and (&#60;Orcamentos.&#34;LOJAMKP&#34;&#62; &#60;&#62; '');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;Orcamentos.&#34;LOJAMKP&#34;&#62; = 'Mercado Livre') then&#13;&#10;    Memo2.Visible := false;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo5OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;Orcamentos.&#34;LOJAMKP&#34;&#62; = 'Mercado Livre') then&#13;&#10;    Memo5.Visible := false;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure EnderecoEntregaTipoFreteEntregaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  EnderecoEntregaTipoFreteEntrega.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; = 'Mercado Livre';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Memo1.Visible := (&#60;Orcamentos.&#34;LOJAMKP&#34;&#62; &#60;&#62; 'Mercado Livre') and (&#60;Orcamentos.&#34;LOJAMKP&#34;&#62; &#60;&#62; '');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo13OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Memo13.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; ='Mercado Livre';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo14OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Memo14.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; = 'Mercado Livre';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Shape5OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Shape5.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; = 'Mercado Livre';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo15OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Memo15.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; ='';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo17OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Memo17.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; ='';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo16OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Memo16.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; ='';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo19OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Memo19.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; ='';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Shape4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Shape4.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; = 'Mercado Livre';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Shape6OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Shape6.Visible := &#60;Orcamentos.&#34;LOJAMKP&#34;&#62; &#60;&#62; 'Mercado Livre';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure EnderecoEntregaEtiquetaContratoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  EnderecoEntregaEtiquetaContrato.Visible := Pos('BY_DIRECT',&#60;EnderecoEntrega.&#34;TipoFreteEntrega&#34;&#62;) &#62; 0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure EnderecoEntregaTipoFreteEntrega2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  EnderecoEntregaTipoFreteEntrega2.Visible := Pos('BY_DIRECT',&#60;EnderecoEntrega.&#34;TipoFreteEntrega&#34;&#62;) &#62; 0;&#13;&#10;  EnderecoEntregaTipoFreteEntrega2.Text := Copy(&#60;EnderecoEntrega.&#34;TipoFreteEntrega&#34;&#62;,Pos('/', &#60;EnderecoEntrega.&#34;TipoFreteEntrega&#34;&#62;)+1, Length(&#60;EnderecoEntrega.&#34;TipoFreteEntrega&#34;&#62;));&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Memo4.Text := Copy(&#60;EnderecoEntrega.&#34;TipoFreteEntrega&#34;&#62;,1,Pos('/', &#60;EnderecoEntrega.&#34;TipoFreteEntrega&#34;&#62;)-1);&#13;&#10;  Memo4.Visible := Pos('BY_DIRECT',&#60;EnderecoEntrega.&#34;TipoFreteEntrega&#34;&#62;) &#62; 0;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." ShowProgress="False" StoreInDFM="False" OnReportPrint="frxReportOnReportPrint">
